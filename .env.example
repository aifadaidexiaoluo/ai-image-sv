# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://designai:designai@127.0.0.1:5432/designai"

ORIGIN="http://localhost:5173"
TRUSTED_ORIGINS="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Comma-separated emails promoted to administrator on registration
ADMIN_EMAILS="admin@example.com"

# MinIO (required for uploads and generated images)
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_PUBLIC_ENDPOINT="http://127.0.0.1:9000"
MINIO_BUCKET="designai"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_REGION="us-east-1"
MINIO_USE_SSL="false"

# BullMQ / Redis
REDIS_URL="redis://127.0.0.1:6379"
JOB_QUEUE_CONCURRENCY="1"

# Image providers. Set MOCK_AI=true for a complete local workflow without external APIs.
MOCK_AI="true"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_IMAGE_MODEL="gpt-image-1"
DASHSCOPE_API_KEY=""
DASHSCOPE_IMAGE_MODEL="wanx-v1"
DASHSCOPE_IMAGE_ENDPOINT="https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis"
REMOVE_BG_API_KEY=""

# Email HTTP gateway. Development logs verification/reset links when unset.
EMAIL_HTTP_ENDPOINT=""
EMAIL_HTTP_TOKEN=""
EMAIL_FROM="DesignAI <noreply@example.com>"

# Sandbox payments
PAYMENT_WEBHOOK_SECRET="development-secret"
